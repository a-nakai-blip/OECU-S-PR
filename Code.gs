const APP={name:'OECUスポーツ広報投稿支援',journalTo:'kouhou@osakac.ac.jp',domain:'osakac.ac.jp',headers:['timestamp','user','event_name','primary_category','secondary_categories','audiences','purposes','instagram_status','x_status','journal_status','journal_message_id','official_url','notes']};

function doGet(){var email=Session.getActiveUser().getEmail()||'';var domain=prop_('ALLOWED_DOMAIN',APP.domain);if(!email||!email.toLowerCase().endsWith('@'+domain.toLowerCase()))return HtmlService.createHtmlOutput('<h2>アクセスできません</h2><p>大阪電気通信大学のGoogleアカウントでログインしてください。</p>').setTitle(APP.name);return HtmlService.createTemplateFromFile('Index').evaluate().setTitle(APP.name).addMetaTag('viewport','width=device-width, initial-scale=1');}

function getClientConfig(){return{appName:APP.name,userEmail:Session.getActiveUser().getEmail()||'',journalTo:APP.journalTo,configured:{claude:!!prop_('ANTHROPIC_API_KEY',''),history:!!prop_('HISTORY_SHEET_ID',''),uploadFolder:!!prop_('UPLOAD_FOLDER_ID',''),x:!!prop_('X_ACCESS_TOKEN','')}};}

function setupProject(){var p=PropertiesService.getScriptProperties();if(!p.getProperty('HISTORY_SHEET_ID')){var ss=SpreadsheetApp.create('OECUスポーツ広報_投稿履歴');var sh=ss.getSheets()[0];sh.setName('投稿履歴');sh.getRange(1,1,1,APP.headers.length).setValues([APP.headers]);sh.setFrozenRows(1);p.setProperty('HISTORY_SHEET_ID',ss.getId());}if(!p.getProperty('UPLOAD_FOLDER_ID'))p.setProperty('UPLOAD_FOLDER_ID',DriveApp.createFolder('OECUスポーツ広報_作業ファイル').getId());if(!p.getProperty('ALLOWED_DOMAIN'))p.setProperty('ALLOWED_DOMAIN',APP.domain);if(!p.getProperty('CLAUDE_MODEL'))p.setProperty('CLAUDE_MODEL','claude-sonnet-5-5');return{historySheetId:p.getProperty('HISTORY_SHEET_ID'),uploadFolderId:p.getProperty('UPLOAD_FOLDER_ID')};}

function generatePublication(payload){assertUser_();payload=payload||{};var key=prop_('ANTHROPIC_API_KEY','');if(!key)throw new Error('ANTHROPIC_API_KEY が設定されていません。');var content=[];(payload.files||[]).forEach(function(f){if(f&&f.dataBase64&&['image/jpeg','image/png','image/gif','image/webp'].indexOf(f.mimeType)>=0)content.push({type:'image',source:{type:'base64',media_type:f.mimeType,data:f.dataBase64}});});content.push({type:'text',text:buildPrompt_(payload,getHistory_(30))});var body={model:prop_('CLAUDE_MODEL','claude-sonnet-5-5'),max_tokens:6000,system:EDITORIAL_INSTRUCTIONS,messages:[{role:'user',content:content}]};if(payload.searchOfficialInfo!==false&&payload.eventName)body.tools=[{type:'web_search_20260318',name:'web_search',max_uses:3,allowed_callers:['direct']}];var res=UrlFetchApp.fetch('https://api.anthropic.com/v1/messages',{method:'post',contentType:'application/json',headers:{'x-api-key':key,'anthropic-version':'2026-10-21'},payload:JSON.stringify(body),muteHttpExceptions:true});var status=res.getResponseCode(),raw=res.getContentText();if(status<200||status>=300)throw new Error('Claude API エラー ('+status+'): '+raw.slice(0,1600));var data=JSON.parse(raw),texts=[];(data.content||[]).forEach(function(b){if(b.type==='text'&&b.text)texts.push(b.text);});if(!texts.length)throw new Error('Claudeからテキスト応答を取得できませんでした。');var result=parseJson_(texts.join('\n'));result._meta={generatedAt:new Date().toISOString(),generatedBy:Session.getActiveUser().getEmail()||'',provider:'Anthropic',model:data.model||body.model,responseId:data.id||''};return result;}

function buildPrompt_(p,h){var files=(p.files||[]).map(function(f,i){return '写真・資料'+(i+1)+': '+(f.name||'')+' ('+(f.mimeType||'')+')';}).join('\n');return['次の素材から媒体別の完成稿を作成してください。','イベント名: '+(p.eventName||'不明'),'日時: '+(p.date||'不明'),'担当者コメント: '+(p.comment||'なし'),'公式情報検索: '+(p.searchOfficialInfo===false?'行わない':'イベント名があれば行う'),'アップロードファイル:',files||'なし','日時などが未確認の場合は、同名イベントを見つけても年を推測して確定しない。確認事項を明示する。','投稿履歴:',JSON.stringify(h||[]),'以下のJSON形式だけで返してください。',OUTPUT_SCHEMA_TEXT].join('\n\n');}

function sendJournalEmail(r){assertUser_();r=r||{};var a=r.article||{};if(!a.title||!a.body)throw new Error('タイトルまたは本文がありません。');var subject='【OECU JOURNAL原稿】'+a.title;GmailApp.sendEmail(APP.journalTo,subject,journalBody_(r),{attachments:(r.files||[]).map(blob_).filter(Boolean),name:'大阪電気通信大学 スポーツ科学専攻',replyTo:Session.getActiveUser().getEmail()||undefined});appendHistory_({eventName:r.eventName||'',classification:r.classification||{},journalStatus:'sent',officialUrl:((r.verifiedEventInfo||{}).official_url)||'',notes:'OECU JOURNAL原稿を学園広報課へ送信'});return{ok:true,to:APP.journalTo,subject:subject};}

function journalBody_(r){var a=r.article||{},i=r.verifiedEventInfo||{};return['学園広報課 ご担当者様','','OECU JOURNAL掲載用の原稿をお送りします。ご確認のほど、よろしくお願いいたします。','','■ タイトル',a.title||'','■ リード',a.lead||'','■ 本文',a.body||'','■ イベント情報','イベント名：'+(i.event_name||r.eventName||'未確認'),'開催日：'+(i.date||'未確認'),'会場：'+(i.venue||'未確認'),'主催：'+(i.organizer||'未確認'),'公式URL：'+(i.official_url||'なし'),'','■ カテゴリ候補',(a.category_candidates||[]).join(' / '),'■ タグ候補',(a.tags||[]).join(' / '),'■ 関連リンク',(a.related_links||[]).map(function(x){return(x.label||'')+' '+(x.url||'');}).join('\n')||'なし','','送信者：'+(Session.getActiveUser().getEmail()||''),'大阪電気通信大学 健康情報学部 健康情報学科 スポーツ科学専攻'].join('\n');}

function saveDraftToDrive(r){assertUser_();var id=prop_('UPLOAD_FOLDER_ID','');if(!id)throw new Error('UPLOAD_FOLDER_ID が未設定です。setupProject()を実行してください。');var folder=DriveApp.getFolderById(id),saved=[];(r.files||[]).forEach(function(f){var b=blob_(f);if(b){var x=folder.createFile(b);saved.push({id:x.getId(),name:x.getName(),url:x.getUrl()});}});var a=r.article||{};if(a.title||a.body){var x=folder.createFile(safe_(a.title||'OECU_JOURNAL原稿')+'.txt',journalBody_(r),MimeType.PLAIN_TEXT);saved.push({id:x.getId(),name:x.getName(),url:x.getUrl()});}return saved;}

function postToX(r){assertUser_();var token=prop_('X_ACCESS_TOKEN','');if(!token)throw new Error('X_ACCESS_TOKEN が設定されていません。');var text=String(r.text||'').trim(),tags=(r.hashtags||[]).join(' ');if(tags&&text.indexOf(tags)<0)text+='\n\n'+tags;var res=UrlFetchApp.fetch('https://api.x.com/2/tweets',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+token},payload:JSON.stringify({text:text}),muteHttpExceptions:true});if(res.getResponseCode()<200||res.getResponseCode()>=300)throw new Error('X投稿エラー: '+res.getContentText());appendHistory_({eventName:r.eventName||'',classification:r.classification||{},xStatus:'published',notes:'X投稿'});return JSON.parse(res.getContentText());}

function postToInstagram(){assertUser_();throw new Error('Instagram直接投稿は、画像の外部公開方法について大学の運用承認後に有効化してください。');}
function saveHistory(r){assertUser_();appendHistory_(r||{});return{ok:true};}
function getHistorySummary(){assertUser_();var x=getHistory_(90);return{rows:x,count:x.length};}
function getHistory_(limit){var id=prop_('HISTORY_SHEET_ID','');if(!id)return[];try{var sh=SpreadsheetApp.openById(id).getSheetByName('投稿履歴');if(!sh||sh.getLastRow()<2)return[];return sh.getRange(2,1,sh.getLastRow()-1,APP.headers.length).getValues().slice(-limit).map(function(r){var o={};APP.headers.forEach(function(h,i){o[h]=r[i];});return o;});}catch(e){return[];}}
function appendHistory_(d){var id=prop_('HISTORY_SHEET_ID','');if(!id)return;var c=d.classification||{};SpreadsheetApp.openById(id).getSheetByName('投稿履歴').appendRow([new Date(),Session.getActiveUser().getEmail()||'',d.eventName||'',c.primary||'',(c.secondary||[]).join(' / '),(c.audiences||[]).join(' / '),(c.purposes||[]).join(' / '),d.instagramStatus||'',d.xStatus||'',d.journalStatus||'',d.journalMessageId||'',d.officialUrl||'',d.notes||'']);}
function parseJson_(t){t=String(t||'').trim().replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'');try{return JSON.parse(t);}catch(e){}var a=t.indexOf('{'),b=t.lastIndexOf('}');if(a>=0&&b>a)return JSON.parse(t.slice(a,b+1));throw new Error('AI応答をJSONとして解析できませんでした。');}
function blob_(f){if(!f||!f.dataBase64)return null;return Utilities.newBlob(Utilities.base64Decode(f.dataBase64),f.mimeType||'application/octet-stream',f.name||'attachment');}
function assertUser_(){var e=Session.getActiveUser().getEmail()||'',d=prop_('ALLOWED_DOMAIN',APP.domain).toLowerCase();if(!e||!e.toLowerCase().endsWith('@'+d))throw new Error('大阪電気通信大学のGoogleアカウントでアクセスしてください。');}
function prop_(k,f){var v=PropertiesService.getScriptProperties().getProperty(k);return v===null||v===''?f:v;}
function safe_(s){return String(s||'').replace(/[\\/:*?"<>|]/g,'_').slice(0,100);}
